@model LoginViewModel
@{
    ViewData["Title"] = "Administrator sign in";
}

<section class="auth-section">
    <div class="shell auth-layout">
        <div class="auth-copy">
            <p class="eyebrow eyebrow-light">Restricted area</p>
            <h1>Keep the guide<br />accurate.</h1>
            <p class="lead">Sign in to update place descriptions, opening hours, travel tips and categories for every visitor.</p>

            <ul class="auth-points">
                <li><span aria-hidden="true">✓</span> Add, edit and remove tourism records</li>
                <li><span aria-hidden="true">✓</span> Maintain categories and featured places</li>
                <li><span aria-hidden="true">✓</span> Changes appear on the public site immediately</li>
            </ul>
        </div>

        <div class="auth-card">
            <div class="auth-card-head">
                <img src="~/images/logo.jpg" alt="" width="46" height="46" />
                <div>
                    <p class="eyebrow">AkuranaExplore</p>
                    <h2>Administrator sign in</h2>
                </div>
            </div>

            <form method="post" asp-controller="Admin" asp-action="Login" class="auth-form">
                <input asp-for="ReturnUrl" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                <div class="field">
                    <label asp-for="Username">Username</label>
                    <input asp-for="Username" autocomplete="username" autofocus placeholder="Enter your admin username" />
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" autocomplete="current-password" placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <label class="checkbox">
                    <input asp-for="RememberMe" />
                    <span>Keep me signed in on this device</span>
                </label>

                <button class="btn btn-primary btn-block" type="submit">Sign in</button>
            </form>

            <p class="auth-help">
                Access is limited to authorised administrators. Need the visitor site?
                <a asp-controller="Home" asp-action="Index">Return home</a>.
            </p>
        </div>
    </div>
</section>
